# Copy to .env in this folder and fill in. Never commit .env.
#
#   Command                         Needs
#   funding-watch run               model endpoint (+ SLACK_BOT_TOKEN when SLACK_MODE=live)
#   funding-watch slack             model endpoint + SLACK_BOT_TOKEN + SLACK_APP_TOKEN
#   funding-watch slack-cleanup     SLACK_BOT_TOKEN
#   funding-watch check             model endpoint (reports on Slack too)

# --- Model endpoint (required) ------------------------------------------------
# Azure OpenAI's OpenAI-compatible /openai/v1 endpoint, or any OpenAI-compatible server.
AZURE_OPENAI_URL=https://<resource>.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
# Model or deployment name
TEST_MODEL_NAME=

# Only for a classic Azure deployment endpoint (no /openai/v1 in the URL):
# OPENAI_API_VERSION=2024-10-21

# --- Slack (setup steps: README.md) -------------------------------------------
# practice: messages are composed and shown, nothing is sent, no tokens needed.
# live: posts to the channel in teams.json.
SLACK_MODE=practice
# Bot User OAuth Token (xoxb-...): for SLACK_MODE=live, `slack` and `slack-cleanup`
SLACK_BOT_TOKEN=
# App-level token (xapp-...) with the connections:write scope: for `slack` only
SLACK_APP_TOKEN=

# --- Optional (defaults shown) ------------------------------------------------
# STRUCTURED_OUTPUT_METHOD=function_calling   # or json_schema
# LLM_MAX_RETRIES=3
# LLM_TIMEOUT=120                             # seconds per model call
# DEMO_TODAY=2026-10-06                       # pin "today" for the look-back window and day counts (default: the real date)
# FUNDING_SOURCE=fixtures                     # what `check` searches: fixtures, live or nsf (the watch itself always reads live Grants.gov)
# SEMINAR_OPPORTUNITY=NSF 26-525              # the record `check` reads when FUNDING_SOURCE is not fixtures
