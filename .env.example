# Copy to .env and fill in. Never commit .env.

# Model endpoint (Azure OpenAI's OpenAI-compatible /openai/v1 endpoint, or any OpenAI-compatible server)
AZURE_OPENAI_URL=https://<resource>.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
TEST_MODEL_NAME=

# Only for a classic Azure deployment endpoint (no /openai/v1 in the URL)
# OPENAI_API_VERSION=2024-10-21

# Optional settings (defaults shown)
# STRUCTURED_OUTPUT_METHOD=function_calling   # json_schema corrupted date fields on the workshop endpoint
# REASONING_SUMMARY=auto                      # stream reasoning summaries (Responses API); off by default,
#                                             # server/serve.py sets it from --reasoning
# LLM_MAX_RETRIES=3
# LLM_TIMEOUT=120
